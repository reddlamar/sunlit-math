{
  "expo": {
    "name": "Sunlit Math",
    "slug": "sunlit-math",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reddlamar.sunlitmath",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon-android.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.reddlamar.sunlitmath",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1F44",
          "image": "./assets/splash-icon.png",
          "imageWidth": 340,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/splash-icon-android.png",
            "imageWidth": 180
          }
        }
      ],
      "expo-iap",
      "expo-audio",
      "expo-font"
    ],
    "owner": "lredd",
    "extra": {
      "eas": {
        "projectId": "18cad5e0-fa44-4178-86e3-6e6737327c33"
      }
    }
  }
}
